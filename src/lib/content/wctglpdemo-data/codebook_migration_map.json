{
  "meta": {
    "schema_version": "1.0",
    "purpose": "Maps the 37 themes + 39 subthemes in codebook.json @ 1.8 to the (theme, subtheme) pairs in codebook.next.json @ 2.0-draft. Used by a future migration script to re-key segment_tags.json's 590 annotations into the new structure.",
    "status": "draft — review every row before running the migration",
    "notes": [
      "Each row maps ONE old id (theme or subtheme) to ONE new (theme, subtheme) pair. Most subthemes collapse to the same destination as their old parent — the granular nuance they carried will be recaptured as keyword clusters in keyword_lexicon.next.json under the new subtheme.",
      "`confidence: certain` means the mapping is unambiguous in context; `confidence: review` means the old tag is genuinely cross-cutting (e.g. risk_calculation applies to both Treatment and Trial decision-making) and a context-sensitive remap is recommended — the migration script should look at co-occurring old tags on the segment to disambiguate, falling back to the listed default.",
      "Old top-level themes without subthemes map directly. Old top-level themes WITH subthemes get a row for the parent AND a row for each subtheme — both rows usually point at the same new destination.",
      "Rows with `kind: drop` indicate old tags that should NOT be carried forward (the new model handles them elsewhere or they were noise)."
    ],
    "ambiguity_strategy": {
      "decision_factor_themes": "Old themes in the `decision_factors` tag_group (risk_calculation, convenience_tradeoff, cost_benefit_reasoning, conditional_decision) are reasoning patterns that apply to BOTH treatment and trial decisions. Default destination is `treatment_decision_factors`; the migration script should remap to `trial_decision_factors` when the same segment also carries an old `trial_*` theme.",
      "injection_experience": "Maps to `treatment_negative_experiences` by default (injection friction is the dominant frame in the corpus). Some segments are positive (dosing_durability) — the migration script can re-target to `treatment_positive_experiences` when sentiment >= 1.",
      "visit_logistics_subthemes": "telehealth and home_visits are often framed as MOTIVATORS (\"if there was telehealth I'd join\") rather than barriers. The old codebook bucketed them under trial_barriers; the migration script can re-target to `trial_motivators` when sentiment >= 1."
    }
  },
